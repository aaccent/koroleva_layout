doctype html
html(lang='ru')
    head
        block head
            title #{ title }
            meta(name='viewport', content='width=device-width, initial-scale=1.0')
            meta(charset='UTF-8')

            link(href=require('styles/styles.scss'), rel='stylesheet')
    body
        .main-wrapper
            main.main
                block main
                block popups
            include ui/popups/delivery/courier/courier
            include ui/popups/delivery/points/points
            include ui/popups/delivery/store/store
            include ui/popups/successful/successful

        block scripts
            script(src=require('scripts/main.ts'), type='module')
