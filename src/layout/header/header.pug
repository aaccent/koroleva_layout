include layout/utils

-
    var menu_left = [
        {
            title: 'Каталог', dataId: 'catalog', catalog: true
        },
        {title: 'Новинки', link: '#'},
        {title: 'Sale', link: '#'},
        {title: 'Коллекции', link: '#'},
    ]

    var menu_right = [
        {title: 'Бренды', link: '#'},
        {title: 'Сертификаты', link: '#'},
        {title: 'О нас', submenu: [
            {name: 'Блог', link: '#'},
            {name: 'О компании', link: '#'},
            {name: 'Бонусная программа', link: '#'},
            {name: 'Информация клиентам', link: '#'},
            ]},
        {title: 'Магазины', link: ''},
    ]

header.header
    .container
        button.header__mobile-burger
        +popupBtn('search').header__mobile-search-button.icon-search
        .header__geo-button-wrapper
            +popupBtn('geo').header__geo-button Екатеринбург
            include ui/geo-notification/geo-notification
        nav.header-menu
            ul.header-menu--left
                each item in menu_left
                    if item.catalog
                        li.header-menu__item(data-id='catalog')= item.title
                            include header-catalog/header-catalog
                    if item.submenu
                        li.header-menu__item= item.title
                            ul.header-menu__item-submenu
                                each sub in item.submenu
                                    li.header-menu__item-submenu-item
                                        +anchor(sub.link)= sub.name
                    else if item.link
                        li.header-menu__item
                            +anchor(item.link)= item.title
            ul.header-menu--right
                each item in menu_right
                    if item.link
                        li.header-menu__item
                            +anchor(item.link)= item.title
                    else if item.submenu
                        li.header-menu__item= item.title
                            ul.header-menu__item-submenu
                                li.header-menu__item-submenu-back= item.title
                                each sub in item.submenu
                                    li.header-menu__item-submenu-item
                                        +anchor(sub.link)= sub.name
                    else
                        li.header-menu__item= item.title
            .header__mobile-buttons
                +popupBtn('geo').header__mobile-buttons-geo г.Екатеринбург
                +popupBtn('authorization').header__mobile-buttons-user Войти в ЛК
            +anchor('tel:88000000000').header__mobile-tel 8 (800) 000-00-00
                .header__mobile-work-hours Пн-Сб: c 8:00 до 20:00
            include ui/socials/socials
            +socials.header__mobile-socials
        +anchor('/').header__logo
            +img(require('assets/icons/logo.svg'))
        .header__buttons
            +popupBtn('search').header__buttons-search.icon.icon--search
            +popupBtn('authorization').header__buttons-user.icon.icon--user
            svg.header__buttons-favorite(
                xmlns='http://www.w3.org/2000/svg',
                width='24',
                height='24',
                viewBox='0 0 24 24',
                fill='none'
            )
                path(
