include layout/utils

.delivery
    .delivery__list
        .delivery__item(data-popup='courier')
            input(type='radio', name='delivery', value='courier')
            .delivery__item-title Курьером СДЭК
                .icon.icon--checkmark
            .delivery__item-info
                span.delivery__item-time 2-3 дня,
                span.delivery__item-price от 400 ₽
        .delivery__item(data-popup='points')
            input(type='radio', name='delivery', value='points')
            .delivery__item-title СДЭК
                .icon.icon--checkmark
            .delivery__item-info
                span.delivery__item-time 2-3 дня,
                span.delivery__item-price от 250 ₽
        .delivery__item(data-popup='store')
            input(type='radio', name='delivery', value='store')
            .delivery__item-title Самовывоз
                .icon.icon--checkmark
            .delivery__item-info
                span.delivery__item-time Сегодня,
                span.delivery__item-price из магазина
