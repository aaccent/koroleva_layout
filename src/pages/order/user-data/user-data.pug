include layout/utils
include ui/input/input

.user-data
    .user-data__text!= 'Осталось заполнить <span>5 обязательных полей</span>'
    .user-data__form
        +input.input--half(type='text', placeholder='Имя*', required)
        +input.input--half(type='text', placeholder='Фамилия*', required)
        +input.input--half(type='text', placeholder='Отчество*', required)
        +input.input--half(type='tel', placeholder='Телефон*', required)
        +input.input--half(type='email', placeholder='E-mail*', required)
