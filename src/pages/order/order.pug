extends layout/order-page
include layout/utils
include order-step/order-step

block append main
    .order
        .order__header
            +img(require('assets/icons/logo.svg')).order__logo
            +anchor.order__close
        .order__content.container
            form.order__step-list
                +order-step({number: 1, title: 'Личные данные', buttonText: 'Войти в ЛК', data:'user-data'})
                    include user-data/user-data
                +order-step({number: 2, title: 'способ доставки', buttonText: 'екатеринбург',data:'delivery'})
                    include delivery/delivery
                +order-step({number: 3, title: 'методы оплаты', data:'payment'})
                    include payment/payment
                .order__button.button(type='submit') подтвердить заказ
            .order__info
