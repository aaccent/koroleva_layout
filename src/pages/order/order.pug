extends layout/order-page
include layout/utils
include order-step/order-step

block append main
    .order
        .order__header
            +img(require('assets/icons/logo.svg')).order__logo
            +anchor.order__close
        .order__content.container
            form.order__step-list(data-handler='path.php', novalidate)
                +order-step({number: 1, title: 'Личные данные', buttonText: 'Войти в ЛК', final:['name', 'tel', 'email']})(
                    data-step='user-data'
                )
                    include user-data/user-data
                +order-step({number: 2, title: 'способ доставки', buttonText: 'екатеринбург', final: ['method', 'address', 'info']})(
                    data-step='delivery'
                )
                    include delivery/delivery
                +order-step({number: 3, title: 'методы оплаты'})(data-step='payment')
                    include payment/payment
                button.order__button.button(type='submit') подтвердить заказ
            .order__info
        include ui/popups/delivery/courier/courier
        include ui/popups/delivery/points/points
        include ui/popups/delivery/store/store
