include layout/utils

mixin order-step(props)
    -
        props = Object.assign({
            number: 1,
            title: '',
            buttonText: '',
            final: []
        }, props || {})
    .order-step&attributes(attributes)
        .order-step__header
            .order-step__number= props.number
            .order-step__title= props.title
            button.order-step__change-button(type='button') изменить
            if props.buttonText
                button.order-step__action-button(type='button')= props.buttonText
        .order-step__content
            block
        .order-step__final
            each item in props.final
                .order-step__final-item(data-final=item)
