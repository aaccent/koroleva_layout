extends layout/page

block append head
    link(href=require('styles/catalog.scss'), rel='stylesheet')

block main
    include ui/breadcrumbs/breadcrumbs
    +breadcrumbs(['Избранное'])
    include components/catalog/catalog--favorites-empty
    include ui/slider/slider
    +slider({title: 'Недавно просмотренные', cards: 'product-card', tag: 'new'})

block popups
    include ui/popups/filter/filter

block append scripts
    script(src=require('scripts/catalog.ts'))
