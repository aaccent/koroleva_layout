extends layout/page

block append head
    link(href=require('styles/catalog.scss'), rel='stylesheet')

block main
    include layout/utils
    include ui/breadcrumbs/breadcrumbs
    +breadcrumbs(['Страница не найдена'])
    section.section.error-404: .container
        h1.error-404__title страница не найдена
        +anchor('/').button.button--arrow.button--fit.error-404__button на главную
        +img(require('assets/static/leafs.svg')).error-404__bg

block popups
    include ui/popups/filter/filter

block append scripts
    script(src=require('scripts/catalog.ts'))
