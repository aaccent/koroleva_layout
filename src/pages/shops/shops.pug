extends layout/page
include layout/utils
include ui/breadcrumbs/breadcrumbs

block main
    -
        var shops = [
        {
            image: require('assets/content/shops/1.png'),
            address: 'ул. Мамина-Сибиряка, 23',
            info: ['ТЦ Грант — 3 этаж',
            'Пн-Пт: с 09:00 до 20:00',
            'Сб-Вск: выходной'],
            tel: '8 921 560-15-16',
            coords:'54.35154455724545, 10.116644715869354'
        },
        {
            image: require('assets/content/shops/2.png'),
            address: 'ул. Мамина-Сибиряка, 3',
            info: ['ТЦ Грант — 3 этаж',
                'Пн-Пт: с 09:00 до 20:00',
                'Сб-Вск: выходной'],
            tel: '8 921 560-15-16',
            coords: '54.35236760710947, 10.091255014472004'
        }

        ]
    +breadcrumbs(['Главная','Магазины'])
    .page-title Магазины
    .shops__general
        .shops__tel 8 (800) 000-00-00
            span Единый номер поддержки 24/7
        include ui/socials/socials
        +socials.shops__socials
    .container
        .shops__actions
            button.shops__map магазины на карте
                .icon.icon--geo
            include ui/selector/selector
            +selector({ name: 'город', list: [{ title: 'авф', value:'выа', shownValue: 'выф' }] })
        .shops__decor
        .shops__tem-wrapper
            each shop in shops
                .shops__item
                    .shops__item-image-wrapper
                        +img(shop.image).shops__item-image
                    .shops__item__info
                        .shops__item-adrdess= shop.address
                        each item in shop.info
                            .shops__item-info-item= item
                        .shops__item-tel= shop.tel
                        +anchor.shops__item-way Проложить маршрут
