extends layout/page
include layout/utils
include ui/breadcrumbs/breadcrumbs

block main
    -
        var shops = [
            {
                images: [require('assets/content/shops/1.png'), require('assets/content/shops/2.png')],
                address: 'ул. Мамина-Сибиряка, 23',
                info: ['ТЦ Грант — 3 этаж',
                'Пн-Пт: с 09:00 до 20:00',
                'Сб-Вск: выходной'],
                tel: '8 921 560-15-16',
                coords:'56.833212, 60.607765',
                city: 'Екатеринбург',
                id: '1'
            },
            {
                images: [require('assets/content/shops/2.png'), require('assets/content/shops/1.png')],
                address: 'ул. Мамина-Сибиряка, 3',
                info: ['ТЦ Грант — 3 этаж',
                    'Пн-Пт: с 09:00 до 20:00',
                    'Сб-Вск: выходной'],
                tel: '8 921 560-15-16',
                coords: '54.35236760710947, 10.091255014472004',
                city: 'Казань',
                id: '2'
            }
        ]
    .shops
        +breadcrumbs(['Магазины'])
        .page-title Магазины
        .shops__general
            .shops__tel 8 (800) 000-00-00
                span Единый номер поддержки 24/7
            include ui/socials/socials
            +socials.shops__socials
        .container
            .shops__actions
                button.shops__map(data-action='popup', data-popup='shops') магазины на карте
                .shops__selector
                    .shops__selector-value= shops[0].city
                    .icon.icon--arrow-short-right
                    .shops__selector-list
                        each item in shops
                            label.shops__selector-item= item.city
                                input(type='radio', name='city', value=item.id)
            .shops__decor
            each shop, index in shops
                .shops-slider.swiper(data-id=shop.id, data-coords=shop.coords)
                    .shops__item-wrapper.swiper-wrapper
                        each image in shop.images
                            .shops__item.swiper-slide
                                .shops__item-image-wrapper
                                    +img(image).shops__item-image
                    .shops__item-info
                        .shops__item-address= shop.address
                        each item in shop.info
                            .shops__item-info-item= item
                        .shops__item-tel= shop.tel
                            .icon.icon--phone
                        +anchor.shops__item-way Проложить маршрут
                    .shops-slider__navigation
                        .shops-slider__navigation-prev
                        .shops-slider__navigation-next

block popups
    include ui/popups/shops-popup/shops-popup
