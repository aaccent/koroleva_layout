include layout/utils

-
    var slides = [
        {
            title: 'новая коллекция нижнего белья',
            buttonText: 'перейти в каталог',
            buttonLink: '#',
            image: require('assets/content/main-hero/1.png'),
            delay: '1'
        },{
            title: '-50% на вторые трусики',
            buttonText: 'перейти в каталог',
            buttonLink: '#',
            image: require('assets/content/main-hero/2.png'),
            delay: '2'
        },{
            title: 'Бюстгальтер бандо с тонкой чашкой',
            buttonText: 'перейти в каталог',
            buttonLink: '#',
            image: require('assets/content/main-hero/3.png'),
            delay: '3'
        },{
            title: 'Love your body by Bilingua Ladies',
            buttonText: 'перейти в каталог',
            buttonLink: '#',
            image: require('assets/content/main-hero/4.png'),
            delay: '4'
        },{
            title: 'новая коллекция нижнего белья',
            buttonText: 'перейти в каталог',
            buttonLink: '#',
            image: require('assets/content/main-hero/1.png'),
            delay: '5'
        },{
            title: '-50% на вторые трусики',
            buttonText: 'перейти в каталог',
            buttonLink: '#',
            image: require('assets/content/main-hero/2.png'),
            delay: '6'
        },{
            title: 'Бюстгальтер бандо с тонкой чашкой',
            buttonText: 'перейти в каталог',
            buttonLink: '#',
            image: require('assets/content/main-hero/3.png'),
            delay: '7'
        }
    ]

section.main-hero
    .main-hero__slider.swiper
        .swiper-wrapper
            each item in slides
                .main-hero__slide.swiper-slide(data-delay=item.delay)
                    +img(item.image).main-hero__slide-image
                    .main-hero__slide-content
                        .main-hero__slide-title= item.title
                        +anchor(item.buttonLink).button.button--arrow.button--outline.main-hero__slide-button= item.buttonText
        .main-hero__slider-controls
            .main-hero__thumbs-slider
                each item, index in slides
                    .main-hero__thumbs-slide
                        +img(item.image).main-hero__thumbs-slide-image
            .main-hero__slider-pagination
            .main-hero__slider-navigation
                .main-hero__slider-navigation-prev
                    svg(width='45', height='24', viewBox='0 0 45 24', fill='none', xmlns='http://www.w3.org/2000/svg')
                        path(
                            d='M45 11.9948H0.589758C4.53733 12.3896 12.4325 10.6921 12.4325 0.744202M0.589758 12.0463C4.53733 11.6516 12.4325 13.349 12.4325 23.2969',
                            stroke='white',
                            stroke-width='1.02326'
                        )
                .main-hero__slider-navigation-next
                    svg(width='45', height='24', viewBox='0 0 45 24', fill='none', xmlns='http://www.w3.org/2000/svg')
                        path(
                            d='M45 11.9948H0.589758C4.53733 12.3896 12.4325 10.6921 12.4325 0.744202M0.589758 12.0463C4.53733 11.6516 12.4325 13.349 12.4325 23.2969',
                            stroke='white',
                            stroke-width='1.02326'
                        )
