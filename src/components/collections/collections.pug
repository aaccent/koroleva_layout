include layout/utils
include ui/collection-card/collection-card

-
    var list = [
        { 
            img: require('assets/content/collections/img-1.jpg'), 
            title: 'Love your body by Bilingua Ladies', 
            tag: 'Базовые'
        },
        { 
            img: require('assets/content/collections/img-2.jpg'), 
            title: 'Have a good date by Corporelle', 
            tag: 'Для невесты'
        },
        { 
            img: require('assets/content/collections/img-3.jpg'), 
            title: 'Adidas by Stella McCartney', 
            tag: 'Базовые'
        },
        { 
            img: require('assets/content/collections/img-4.jpg'), 
            title: 'Sexy black by Agent Provocateur', 
            tag: 'Для невесты'
        },
    ]

section.section.collections: .container
    .collections__top
        h1.collections__title.page-title Коллекции
        nav.collections__links-list-wrapper: .collections__links-list
            +anchor.collections__links-list-item.active Все коллекции
            +anchor.collections__links-list-item Невидимые
            +anchor.collections__links-list-item Базовые
            +anchor.collections__links-list-item Для невесты
    .collections__body-wrapper
        .collections__body
            each card in list
                +collection-card(card).collections__body-item
        button.button.button--arrow.button--outline.button--light.button--fit.button--center показать ещё
