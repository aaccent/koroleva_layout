include layout/utils
include ui/selector/selector

mixin filter(props)
    -
        props = Object.assign({
            viewSwitcher: true,
            textAmount: 'найдено',
            empty: false,
        }, props || {})

    .filter
        unless props.empty
            include ui/buttons/filter-button/filter-button
            span.filter__amount.text-amount 26#{ props.textAmount }
            if props.viewSwitcher
                include ui/buttons/view-switcher/view-switcher
            +sort-selector
