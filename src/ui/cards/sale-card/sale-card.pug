include layout/utils

mixin sale-card(props)
    -
        props = Object.assign({
            image: require('assets/content/main-hero/2.png'),
            title: '-50% на вторые трусики',
            dates: '20 мая — 15 июня'
        }, props || {})
    +anchor.sale-card
        +img(props.image).sale-card__image
        .sale-card__container
            .sale-card__dates= props.dates
            .sale-card__title= props.title
            svg(width='153', height='78', viewBox='0 0 153 78', fill='none', xmlns='http://www.w3.org/2000/svg')
                path(
                    d='M0 38.9812H152.044C138.529 40.3327 111.499 34.5212 111.499 0.463257M152.044 39.1576C138.529 37.8061 111.499 43.6176 111.499 77.6755',
                    stroke='white',
                    stroke-width='2'
                )
