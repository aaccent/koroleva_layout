include layout/utils
include features/popup/popup
-
    var shops = [
        {
            image: require('assets/content/shops/1.png'),
            address: 'ул. Мамина-Сибиряка, 23',
            info: ['ТЦ Грант — 3 этаж',
                'Пн-Пт: с 09:00 до 20:00',
                'Сб-Вск: выходной'],
            tel: '8 921 560-15-16',
            coords:'54.35154455724545, 10.116644715869354',
            city: 'Екатеринбург',
            id: '1'
        },
        {
            image: require('assets/content/shops/2.png'),
            address: 'ул. Мамина-Сибиряка, 3',
            info: ['ТЦ Грант — 3 этаж',
                'Пн-Пт: с 09:00 до 20:00',
                'Сб-Вск: выходной'],
            tel: '8 921 560-15-16',
            coords: '54.35236760710947, 10.091255014472004',
            city: 'Казань',
            id: '2'
        }
    ]

+popup('shops', 'shops')
    each shop in shops
        .shops__item(data-city=shop.city, data-coords=shop.coords)
            .shops__item-image-wrapper
                +img(shop.image).shops__item-image
            .shops__item-info
                .shops__item-address= shop.address
                each item in shop.info
                    .shops__item-info-item= item
                .shops__item-tel= shop.tel
                    .icon.icon--phone
    .shops-popup__button.button.button--arrow проложить маршрут
