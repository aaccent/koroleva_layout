include layout/utils
include features/popup/popup

+popup('points', 'points')
    .points-popup__data-list
        div(
            data-id='3',
            data-address='пр-кт Металлургов, 56',
            data-price='Стоимость доставки — 250 ₽',
            data-date='Дата доставки — понедельник, 19 июня',
            data-coords='55.79182659084871,49.11312580123732',
            data-image='assets/static/point-image.png',
            data-workHours='Ежедневно: 09:00-18:00'
        )
    button.points-popup__show-list(type='button') пункты списком
    .points-popup__content
        button.points-popup__content-close
            .icon.icon--close
        .points-popup__content-list
            .popup__title пункты выдачи
            .points-popup__search
                input(type='text', name='search', placeholder='Найти адрес пункта')
                .icon.icon--search
            .points-popup__list._empty
            .points-popup__item._layout
                .points-popup__item-container
                    .points-popup__item-info.points-popup__item-info--address(data-point='address') пр-кт Металлургов, 56
                    .points-popup__item-info.points-popup__item-info--price(data-point='price') Стоимость доставки — 250 ₽
                    .points-popup__item-info.points-popup__item-info--date(data-point='date') Дата доставки — понедельник, 19 июня
                    .points-popup__item-info.points-popup__item-info--work-hours(data-point='work-hours') Ежедневно: 09:00-18:00
                        .icon.icon--clock
                button.points-popup__item__button(type='button') выбрать
    .points-popup__balloon-mobile(data-balloon='id')
        button.points-popup__balloon-mobile-close(type='button')
        .points-popup__balloon-mobile-content
            +img.points-popup__balloon-mobile-image(data-balloon='image')
            .points-popup__balloon-mobile-address(data-balloon='address', data-point='address')
            .points-popup__balloon-mobile-price(data-balloon='price')
            .points-popup__balloon-mobile-date(data-balloon='date', data-point='date')
            .points-popup__balloon-mobile-work-hours(data-balloon='work-hours')
                .icon.icon--clock
            button.points-popup__balloon-mobile-button.button.button--arrow(type='button') выбрать этот пункт
